{{ ansible_managed | comment }}

## Provides modern Erlang/OTP releases
##
deb [arch=amd64 signed-by={{ rabbitmq_erlang_repo_keyserver_dst | default(__rabbitmq_erlang_repo_keyserver_dst) }}] https://ppa1.rabbitmq.com/rabbitmq/rabbitmq-erlang/deb/ubuntu {{ ansible_distribution_release }} main
deb-src [signed-by={{ rabbitmq_erlang_repo_keyserver_dst | default(__rabbitmq_erlang_repo_keyserver_dst) }}] https://ppa1.rabbitmq.com/rabbitmq/rabbitmq-erlang/deb/ubuntu {{ ansible_distribution_release }} main

# another mirror for redundancy
deb [arch=amd64 signed-by={{ rabbitmq_erlang_repo_keyserver_dst | default(__rabbitmq_erlang_repo_keyserver_dst) }}] https://ppa2.rabbitmq.com/rabbitmq/rabbitmq-erlang/deb/ubuntu {{ ansible_distribution_release }} main
deb-src [signed-by={{ rabbitmq_erlang_repo_keyserver_dst | default(__rabbitmq_erlang_repo_keyserver_dst) }}] https://ppa2.rabbitmq.com/rabbitmq/rabbitmq-erlang/deb/ubuntu {{ ansible_distribution_release }} main

